# Built OmniRT service image. Use a commit-specific tag for production.
OMNIRT_AVATAR_IMAGE=omnirt-avatar-ws:replace-with-verified-sha

# Existing RTX 4090 host paths. Adjust explicitly on other servers.
OMNIRT_SHARED_ROOT=/home/ubuntu/digital-human-shared
OMNIRT_QUICKTALK_CHECKPOINTS_ROOT=/home/ubuntu/digital-human/models/quicktalk/checkpoints
OMNIRT_FASTLIVEPORTRAIT_CHECKPOINTS_ROOT=/home/ubuntu/digital-human/models/FasterLivePortrait/checkpoints
OMNIRT_MODEL_NETWORK=digital-human-flashhead-inference
